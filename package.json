{
  "name": "resume-builder-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @cvb/api --filter @cvb/web dev",
    "build": "pnpm --filter @cvb/shared build && pnpm --filter @cvb/templates build && pnpm --filter @cvb/web build && pnpm --filter @cvb/api build",
    "test": "vitest run",
    "lint:copy": "tsx scripts/copy-lint.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@neondatabase/serverless": "^1.2.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
